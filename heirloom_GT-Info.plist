<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the generated Info.plist. Lets the app reach the heirloom-api server over plain HTTP on the
	     local network (the Mac's IP during development); internet connections still require HTTPS. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- iOS asks the user before an app talks to devices on the local network. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>HeirLoom connects to your family's story server on this network to save and load memories.</string>
	<!-- Custom URL scheme for deep-linking from the Share Extension -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.heirloom.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>heirloom</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
