BACKBOARD_API_KEY=your-key-here
# Optional. Omit both to use the SDK defaults (OpenAI gpt-4o).
# BACKBOARD_LLM_PROVIDER=xai
# BACKBOARD_MODEL=grok-4

# Atlas connection string. Percent-encode special characters in the password (@ becomes %40).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?appName=TestCluster
MONGODB_DATABASE=heirloom

XAI_API_KEY=your-key-here
# XAI_BASE_URL=https://api.x.ai/v1
# GROK_REASONING_MODEL=grok-4.6
# GROK_IMAGE_MODEL=grok-imagine-image

# Shared secret the iOS app sends as "Authorization: Bearer <token>". Generate a long random value.
HEIRLOOM_API_TOKEN=your-key-here
HEIRLOOM_FAMILY_ID=fam_clarke_001
